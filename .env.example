# Copy this file to .env and fill in what you need.
# The app runs without an LLM key: tests, scoring and CSV export all work.
# Diagnosis, tutoring and mastery checks need the three LLM values below.

# Which provider to call: anthropic, openai or google
LLM_PROVIDER=anthropic

# The model id from that provider's console, for example the Sonnet model you have access to.
# It is sent to the provider exactly as written.
LLM_MODEL=

# Server-side only. Never put this in client code and never commit it.
LLM_API_KEY=

# Teacher view password. Pick something only the teacher knows.
TEACHER_PIN=

# true turns on the study mode consent screen and the stuckpoint/control groups.
STUDY_MODE=false

# Where the SQLite file lives. Defaults to ./data/stuckpoint.db
DB_PATH=./data/stuckpoint.db

# Rough prices used only for the cost estimate in the evaluation script, in USD per million tokens.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0
